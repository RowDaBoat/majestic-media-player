    "text": "",
    "card": true,
    "name": "output",
    "kind": "value",
    "content": "~/joined.mp4",
    "rect": 0,
    "dim": "none",
    "path": true,
    "reveal": false,
    "play": true,
    "list": "args"
   }
  ]
