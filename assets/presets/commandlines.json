 {
  "title": "Join videos",
  "parts": [
   {
    "text": "set -o pipefail; n=0; T=0; W=; A=0; fc=; cat=; in=(); hv=(); ha=(); d=(); fs=(); m=$(mktemp) || exit; trap 'rm -f \"$m\"' EXIT; echo ';FFMETADATA1' > \"$m\"; for f in ",
    "card": false,
    "name": "",
    "kind": "value",
    "content": "",
    "rect": 0,
    "dim": "none",
    "path": false,
    "reveal": false,
