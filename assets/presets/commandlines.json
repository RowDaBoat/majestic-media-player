    "rect": 0,
    "dim": "none",
    "path": false,
    "reveal": false,
    "play": false,
    "list": "args"
   },
   {
    "text": "; do [ \"$f\" -ef ",
    "card": false,
    "name": "",
    "kind": "value",
    "content": "",
    "rect": 0,
    "dim": "none",
    "path": false,
    "reveal": false,
    "play": false,
    "list": "args"
   },
   {
    "text": "",
    "card": true,
    "name": "output",
    "kind": "value",
    "content": "~/joined.mp4",
    "rect": 0,
    "dim": "none",
    "path": true,
    "reveal": false,
    "play": true,
    "list": "args"
   },
   {
    "text": " ] && { echo \"The output is one of the files to join: $f\" >&2; exit 1; }; s=$(ffprobe -v error -select_streams V:0 -show_entries stream=width,height,sample_aspect_ratio,avg_frame_rate,r_frame_rate:stream_side_data=rotation:format=duration -of default=nw=1 \"$f\" | awk -F= '{v[$1] = $2} END {w = v[\"width\"]; h = v[\"height\"]; split(v[\"sample_aspect_ratio\"], s, \":\"); if (s[1] > 0 && s[2] > 0) w = w * s[1] / s[2]; if (v[\"rotation\"] % 180) {t = w; w = h; h = t}; r = v[\"avg_frame_rate\"]; split(r, q, \"/\"); if (!(q[2] > 0 && q[1] / q[2] > 0 && q[1] / q[2] <= 240)) r = v[\"r_frame_rate\"]; split(r, q, \"/\"); if (!(q[2] > 0 && q[1] / q[2] > 0 && q[1] / q[2] <= 240)) r = 30; print (w > 0), int(w / 2 + .5) * 2, int(h / 2 + .5) * 2, r, v[\"duration\"] + 0}') || { echo \"Cannot read $f\" >&2; exit 1; }; read -r v w h r t <<< \"$s\"; [ \"$t\" = 0 ] && { echo \"Cannot tell how long this file is: $f\" >&2; exit 1; }; a=$(ffprobe -v error -select_streams a:0 -show_entries stream=index -of csv=p=0 \"$f\"); [ \"$v\" = 1 ] && [ -z \"$W\" ] && { W=$w; H=$h; R=$r; }; [ -n \"$a\" ] && A=1; hv+=(\"$v\"); ha+=(\"${a:+1}\"); d+=(\"$t\"); in+=(-i \"$f\"); fs+=(\"$f\"); n=$((n + 1)); done; [ -n \"$W\" ] || { echo \"None of the files has a picture.\" >&2; exit 1; }; for ((i = 0; i < n; i++)); do read -r k t <<< \"$(awk -v d=\"${d[i]}\" -v r=\"$R\" -v a=\"$A\" 'BEGIN {split(r, q, \"/\"); f = q[1] / (q[2] ? q[2] : 1); k = int(a ? d * f + 1e-6 : d * f + .5); if (k < 1) k = 1; print k, a ? d : k / f}')\"; if [ \"${hv[i]}\" = 1 ]; then fc+=\"[$i:V:0]scale=trunc(iw*sar/2)*2:ih,setsar=1,scale=$W:$H:force_original_aspect_ratio=decrease:force_divisible_by=2,pad=$W:$H:(ow-iw)/2:(oh-ih)/2,setsar=1,fps=$R,format=yuv420p,tpad=stop=-1:stop_mode=clone,trim=end_frame=$k[v$i];\"; else fc+=\"color=black:s=${W}x$H:r=$R,format=yuv420p,trim=end_frame=$k[v$i];\"; fi; cat+=\"[v$i]\"; if [ \"$A\" = 1 ]; then if [ \"${ha[i]}\" = 1 ]; then fc+=\"[$i:a:0]aresample=48000,aformat=sample_fmts=fltp:sample_rates=48000:channel_layouts=stereo,apad,atrim=duration=$t[a$i];\"; else fc+=\"anullsrc=r=48000:cl=stereo,atrim=duration=$t[a$i];\"; fi; cat+=\"[a$i]\"; fi; e=${fs[i]##*[/\\\\]}; printf '[CHAPTER]\\nTIMEBASE=1/1000\\nSTART=%s\\nEND=%s\\ntitle=%s\\n' $(awk -v a=\"$T\" -v b=\"$t\" 'BEGIN {printf \"%d %d\", a * 1000 + .5, (a + b) * 1000 + .5}') \"$(sed 's/[=;#\\\\]/\\\\&/g' <<< \"${e%.*}\")\" >> \"$m\"; T=$(awk -v a=\"$T\" -v b=\"$t\" 'BEGIN {printf \"%.6f\", a + b}'); done; fc+=\"${cat}concat=n=$n:v=1:a=$A[c]\"; maps=(-map \"[v]\"); [ \"$A\" = 1 ] && { fc+=\"[a]\"; maps+=(-map \"[a]\" -c:a aac -b:a 192k); }; fc+=\";[c]fps=$R[v]\"; echo \"Joining $n files at ${W}x$H, $R fps\"; ffmpeg -hide_banner -y \"${in[@]}\" -f ffmetadata -i \"$m\" -filter_complex \"$fc\" \"${maps[@]}\" -map_chapters $n -map_metadata $n -c:v libx264 -crf 18 -preset medium -movflags +faststart ",
    "card": false,
    "name": "",
    "kind": "value",
    "content": "",
    "rect": 0,
    "dim": "none",
    "path": false,
    "reveal": false,
    "play": false,
    "list": "args"
   },
